-- === СБОР ID ИЗ ANIMATE ===
local function collectAnimateIds(character)
    local ids = {}
    if not character then return ids end
    local animate = character:FindFirstChild("Animate")
    if not animate then return ids end

    for _, d in ipairs(animate:GetDescendants()) do
        if d:IsA("Animation") then
            local id = tostring(d.AnimationId):gsub("rbxassetid://", "")
            if id ~= "" and id ~= "0" then ids[id] = true end
        elseif d:IsA("StringValue") or d:IsA("NumberValue") then
            local val = tostring(d.Value):gsub("rbxassetid://", "")
            if val:match("^%d+$") then ids[val] = true end
        end
    end
    return ids
end

