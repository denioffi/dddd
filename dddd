                    idBtn.BackgroundColor3 = Color3.fromRGB(45, 55, 75)
                    idBtn.Text = cleanId
                end
            end)
        end
    end)
end

local function updateList()
    for player in pairs(trackedPlayers) do
        if ready[player.Name] then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    local animator = hum:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            if track.Animation then
                                addEntry(player.Name, track.Animation.AnimationId)
                            end
                        end
                    end
                end
            end
        end
    end
end

local function bindAnimator(player, char)
    if animConns[player] then animConns[player]:Disconnect(); animConns[player] = nil end
    ready[player.Name] = false
    animateIds[player.Name] = {}

    task.spawn(function()
        local animate = char:WaitForChild("Animate", 5)
        if animate then
            task.wait(1)
            animateIds[player.Name] = collectAnimateIds(char)
            task.wait(2)
            local more = collectAnimateIds(char)
            for id in pairs(more) do
                animateIds[player.Name][id] = true
            end
        end
        ready[player.Name] = true
    end)

    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 10)
    if not animator then return end
    animConns[player] = animator.AnimationPlayed:Connect(function(track)
        if track.Animation and trackedPlayers[player] and ready[player.Name] then
            addEntry(player.Name, track.Animation.AnimationId)
        end
    end)
end

local function stopAll()
    if updateConn then updateConn:Disconnect(); updateConn = nil end
    for _, c in pairs(animConns) do c:Disconnect() end
    animConns = {}
    trackedPlayers = {}
    animateIds = {}
    ready = {}
end

local function startTracking(playerList)
    stopAll()
    clearList()
    if #playerList == 0 then return end

    for _, player in ipairs(playerList) do
        trackedPlayers[player] = true
        if player.Character then bindAnimator(player, player.Character) end
        player.CharacterAdded:Connect(function(c)
            if trackedPlayers[player] then bindAnimator(player, c) end
        end)
    end

    local names = {}
    for p in pairs(trackedPlayers) do table.insert(names, p.Name) end
    table.sort(names)
    statusLabel.Text = "Слежу за: " .. table.concat(names, ", ")

    updateConn = RunService.Heartbeat:Connect(updateList)
end

local function parseNames(text)
    local names = {}
    for token in text:gmatch("[^,%s;]+") do
        if token ~= "" then table.insert(names, token) end
    end
    return names
end

searchBtn.MouseButton1Click:Connect(function()
    local names = parseNames(nameBox.Text)
    if #names == 0 then return end
    local found, missing = {}, {}
    for _, name in ipairs(names) do
        local p = Players:FindFirstChild(name)
        if p then table.insert(found, p) else table.insert(missing, name) end
    end
    if #found > 0 then startTracking(found) end
    if #missing > 0 then searchBtn.Text = "Нет: " .. #missing else searchBtn.Text = "Слежу ✔" end
    task.wait(1.5)
    searchBtn.Text = "Найти"
end)

nameBox.FocusLost:Connect(function(enter)
    if enter then searchBtn:Activate() end
end)

-- === СПИСОК ИГРОКОВ ===
local playerRows = {}   -- [player] = row
local playerSearchText = ""

local function rebuildPlayersList()
    for _, row in pairs(playerRows) do row:Destroy() end
    playerRows = {}

    local filter = playerSearchText:lower()
    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)

    for _, plr in ipairs(list) do
        if filter == "" or plr.Name:lower():find(filter, 1, true) then
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -8, 0, 30)
            row.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            row.BorderSizePixel = 0
            row.Parent = playersScroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            -- Ник (кликабельный — копирует ник)
            local nameBtn = Instance.new("TextButton")
            nameBtn.Size = UDim2.new(1, -40, 0.6, 0)
            nameBtn.Position = UDim2.new(0, 6, 0, 0)
            nameBtn.BackgroundTransparency = 1
            nameBtn.Text = plr.Name
            nameBtn.TextColor3 = (plr == LocalPlayer) and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(220, 220, 240)
            nameBtn.Font = Enum.Font.GothamBold
            nameBtn.TextSize = 11
            nameBtn.TextXAlignment = Enum.TextXAlignment.Left
            nameBtn.TextTruncate = Enum.TextTruncate.AtEnd
            nameBtn.Parent = row

            local nameHint = Instance.new("TextLabel")
            nameHint.Size = UDim2.new(1, -40, 0.4, 0)
            nameHint.Position = UDim2.new(0, 6, 0.6, 0)
            nameHint.BackgroundTransparency = 1
            nameHint.Text = "нажми чтобы скопировать ник"
            nameHint.TextColor3 = Color3.fromRGB(100, 100, 120)
            nameHint.Font = Enum.Font.Gotham
            nameHint.TextSize = 8
            nameHint.TextXAlignment = Enum.TextXAlignment.Left
            nameHint.Parent = row

            -- Кнопка «+» — добавить в отслеживание
            local addBtn = Instance.new("TextButton")
            addBtn.Size = UDim2.new(0, 28, 0, 28)
            addBtn.Position = UDim2.new(1, -34, 0, 1)
            addBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
            addBtn.Text = "+"
            addBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            addBtn.Font = Enum.Font.GothamBold
            addBtn.TextSize = 16
            addBtn.Parent = row
            Instance.new("UICorner", addBtn).CornerRadius = UDim.new(0, 6)

            nameBtn.MouseButton1Click:Connect(function()
                if setclipboard then
                    setclipboard(plr.Name)
                    nameBtn.Text = "✅ " .. plr.Name
                    nameBtn.TextColor3 = Color3.fromRGB(100, 255, 150)
                    showToast("Ник скопирован: " .. plr.Name)
                    task.delay(1, function()
                        if nameBtn and nameBtn.Parent then
                            nameBtn.Text = plr.Name
                            nameBtn.TextColor3 = (plr == LocalPlayer) and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(220, 220, 240)
                        end
                    end)
                end
            end)

            addBtn.MouseButton1Click:Connect(function()
                -- Добавляем ник в поле и запускаем отслеживание этого игрока
                local current = nameBox.Text
                if current == "" then
                    nameBox.Text = plr.Name
                else
                    -- Проверяем, нет ли уже
                    local already = false
                    for token in current:gmatch("[^,%s;]+") do
                        if token:lower() == plr.Name:lower() then already = true break end
                    end
                    if not already then
                        nameBox.Text = current .. ", " .. plr.Name
                    end
                end
                -- Запускаем отслеживание всех из поля
                searchBtn:Activate()
            end)

            playerRows[plr] = row
        end
    end
end

